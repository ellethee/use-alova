{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "quoteProps": "as-needed",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": ["dist", "docs", "node_modules", "coverage", "pnpm-lock.yaml", "CHANGELOG.md"]
}
